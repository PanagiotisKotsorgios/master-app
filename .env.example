# ============================================================
# .env.example — copy to .env locally, or set in Coolify
# ============================================================

# ── Application ────────────────────────────────
APP_NAME=MAster
APP_URL=https://your-domain.com
SESSION_LIFETIME=28800

# ── Database (MySQL 8 / MariaDB 10.5+) ─────────
DB_HOST=db
DB_NAME=master_db
DB_USER=master
DB_PASS=change-me-strong-password
DB_CHARSET=utf8mb4

# ── Cron endpoints (shared secret, required to hit /cron/*.php over HTTP) ──
CRON_SECRET=change-me-random-64-chars

# ── Email (Brevo / Sendinblue transactional) ───
BREVO_API_KEY=
MAIL_FROM_EMAIL=noreply@your-domain.com
MAIL_FROM_NAME=MAster

# ── Optional: PHP tuning (read by php-fpm/apache in Docker) ──
PHP_MEMORY_LIMIT=256M
PHP_UPLOAD_MAX_FILESIZE=10M
PHP_POST_MAX_SIZE=12M
